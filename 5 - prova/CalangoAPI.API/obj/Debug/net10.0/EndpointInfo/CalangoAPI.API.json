  "components": {
    "schemas": {
      "AlocarMotoristaRequest": {
        "required": [
          "motoristaId",
          "viagemId"
        ],
        "type": "object",
        "properties": {
          "motoristaId": {
            "type": "string",
            "format": "uuid"
          },
          "viagemId": {
            "type": "string",
            "format": "uuid"
          }
        }
      },
      "CadastrarMotoristaRequest": {
        "required": [
          "nome",
          "cartaConducao"
        ],
        "type": "object",
        "properties": {
          "nome": {
            "type": "string"
          },
          "cartaConducao": {
            "type": "string"
          }
        }
      },
      "CadastrarOnibusRequest": {
        "required": [
          "placa",
          "capacidade",
          "tipo"
        ],
        "type": "object",
        "properties": {
          "placa": {
            "type": "string"
          },
          "capacidade": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "tipo": {
            "type": "string"
          }
        }
      },
      "CadastrarRotaRequest": {
        "required": [
          "nome",
          "pontosDeVendaIds",
          "paradas"
        ],
        "type": "object",
        "properties": {
          "nome": {
            "type": "string"
          },
          "pontosDeVendaIds": {
            "type": "array",
            "items": {
              "pattern": "^-?(?:0|[1-9]\\d*)$",
              "type": [
                "integer",
                "string"
              ],
              "format": "int32"
            }
          },
          "paradas": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ParadaRequest"
            }
          }
        }
      },
      "CadastrarViagemRequest": {
        "required": [
          "rotaId",
          "onibusId",
          "dataPartida"
        ],
        "type": "object",
        "properties": {
          "rotaId": {
            "type": "string",
            "format": "uuid"
          },
          "onibusId": {
            "type": "string",
            "format": "uuid"
          },
          "dataPartida": {
            "type": "string",
            "format": "date-time"
          },
          "motoristaId": {
            "type": [
              "null",
              "string"
            ],
            "format": "uuid"
          }
        }
      },
      "CalcularPrecoRequest": {
        "required": [
          "viagemId",
          "paradaOrigemId",
          "paradaDestinoId"
        ],
        "type": "object",
        "properties": {
          "viagemId": {
            "type": "string",
            "format": "uuid"
          },
          "paradaOrigemId": {
            "type": "string",
            "format": "uuid"
          },
          "paradaDestinoId": {
            "type": "string",
            "format": "uuid"
          }
        }
      },
      "ComprarPassagemRequest": {
        "required": [
          "viagemId",
          "paradaOrigemId",
          "paradaDestinoId",
          "passageiroId",
          "assento"
        ],
        "type": "object",
        "properties": {
          "viagemId": {
            "type": "string",
            "format": "uuid"
          },
          "paradaOrigemId": {
            "type": "string",
            "format": "uuid"
          },
          "paradaDestinoId": {
            "type": "string",
            "format": "uuid"
          },
          "passageiroId": {
            "type": "string",
            "format": "uuid"
          },
          "assento": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          }
        }
      },
      "LoginRequest": {
        "required": [
          "email",
          "senha"
        ],
        "type": "object",
        "properties": {
          "email": {
            "type": "string"
          },
          "senha": {
            "type": "string"
          }
        }
      },
      "ParadaRequest": {
        "required": [
          "nomeLocalidade",
          "ordem",
          "distanciaInicialKm"
        ],
        "type": "object",
        "properties": {
          "nomeLocalidade": {
            "type": "string"
          },
          "ordem": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "distanciaInicialKm": {
            "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?$",
            "type": [
              "number",
              "string"
            ],
            "format": "double"
          }
        }
      },
      "RegistrarRequest": {
        "required": [
          "email",
          "senha"
        ],
        "type": "object",
        "properties": {
          "email": {
            "type": "string"
          },
          "senha": {
            "type": "string"
          }
        }
      }
    },
    "securitySchemes": {
      "Bearer": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    }
  },
  "tags": [
    {
      "name": "Auth"
    },
